# Copy to .env.local and fill in values from your Supabase project
# (Project Settings -> API). Never commit .env.local.
#
# The anon key is designed to be public, but it only stays safe if
# Row Level Security is enabled and correct on every table and bucket.
# Do NOT put the service_role key in any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
